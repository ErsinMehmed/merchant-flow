# Optional local overrides. Docker Compose works without copying this file.
# These defaults are for local demo data only.
APP_PORT=8080
DB_DATABASE=merchant_flow
DB_USERNAME=merchant_flow
DB_PASSWORD=local-demo-password
DB_ROOT_PASSWORD=local-demo-root-password
# Optional runtime license for Nova. Keep the value in the ignored .env file.
NOVA_LICENSE_KEY=
